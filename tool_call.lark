start: tool_call

tool_call: "{" name_field COMMA args_field "}"

name_field: "\"name\"" ":" STRING
args_field: "\"args\"" ":" object

?value: STRING
      | SIGNED_NUMBER
      | "true"
      | "false"
      | object
      | array
      | "null"

object: "{" [pair (COMMA pair)*] "}"
pair: STRING ":" value

array: "[" [value (COMMA value)*] "]"

STRING: "\"" /[^"\\]*/ "\""
COMMA: ","
%import common.SIGNED_NUMBER
%ignore /[ \t\n\r]+/
